# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (Neon dashboard → Connect → Pooled connection)
DATABASE_URL="postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/moringa?sslmode=require"

# Public URL of the app (used for Stripe redirects and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe, TEST MODE ONLY (Dashboard → Developers → API keys). Leave empty for demo checkout.
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=""

# Auth.js: signs the session cookie. Required on Vercel. Generate one with: npx auth secret
AUTH_SECRET=""
